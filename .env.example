# Copia este archivo como ".env" y llena tus valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# --- Twilio (envío de WhatsApp vía BSP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp habilitado en Twilio, formato: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Opcional: ContentSid de una plantilla aprobada (Twilio Content API).
# Si se deja vacío, se manda un mensaje de texto libre (solo sirve dentro
# de la ventana de sesión de 24h o en el sandbox de pruebas de Twilio).
TWILIO_CONTENT_SID=

# --- Base de datos ---
# Si se deja vacío, la app usa SQLite local (data/invitados.db).
AUTOCONFIRM_DATABASE_URL=

# --- Enlaces públicos ---
CONFIRMATION_BASE_URL=https://autoconfirm.onrender.com/confirmar
DASHBOARD_URL=https://autoconfirm.onrender.com/dashboard

# --- Acceso al dashboard (app.py) ---
# Sin ADMIN_PASSWORD, /dashboard y /exportar_csv quedan deshabilitados (503)
# en vez de quedar públicos.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
