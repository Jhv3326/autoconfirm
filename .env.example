# Copia este archivo como ".env" y llena tus valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# --- app.py (dashboard multi-tenant) ---
# Firma las sesiones de login. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Cifra las credenciales de Twilio de cada organización en la base de datos.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambias después de tener organizaciones creadas, sus credenciales
# guardadas quedan ilegibles — trátala como un secreto permanente.
ENCRYPTION_KEY=

# --- Base de datos ---
# Si se deja vacío, la app usa SQLite local (data/invitados.db).
AUTOCONFIRM_DATABASE_URL=

# --- Solo para las apps de escritorio legacy (main_app_meta_test.py,
# experimental/main_apptwilio.py) ---
# El dashboard web (app.py) YA NO usa estas variables: cada organización
# guarda sus propias credenciales de Twilio cifradas en la base de datos
# (ver crear_cliente.py), y el link de confirmación lo arma app.py solo
# con el dominio de la petición (request.host_url).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
CONFIRMATION_BASE_URL=https://autoconfirm.onrender.com/confirmar
